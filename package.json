{
  "name": "mlx-node-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for mlx-node - Node.js bindings for MLX",
  "type": "module",
  "scripts": {
    "setup": "./scripts/setup-mlx-source.sh",
    "build": "turbo run build",
    "test": "turbo run test",
    "generate": "turbo run generate",
    "build:native": "turbo run build:native",
    "clean": "turbo run clean && rm -rf node_modules",
    "check-coverage": "node packages/cli/scripts/check-coverage.js",
    "validate": "python3 packages/cli/scripts/validate-completeness.py",
    "check:mlx-version": "pnpm --filter mlx-node check:mlx-version"
  },
  "keywords": [
    "mlx",
    "machine-learning",
    "apple-silicon",
    "neural-network",
    "gpu",
    "metal",
    "native"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/user/mlx-node.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.0"
}
