{
  "name": "@mlx-node/codegen",
  "version": "0.1.0",
  "description": "Code generators for mlx-node (TypeScript definitions and N-API bindings)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mlx-generate": "./dist/generate-from-cpp.js",
    "mlx-check-bindings": "./dist/check-bindings.js",
    "mlx-check-version": "./dist/check-mlx-version.js",
    "mlx-convert-tests": "./dist/test-converter/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && chmod +x dist/test-converter/index.js",
    "clean": "rm -rf dist",
    "generate": "node dist/generate-from-cpp.js",
    "check-bindings": "node dist/check-bindings.js",
    "check:mlx-version": "node dist/check-mlx-version.js",
    "convert-tests": "node dist/test-converter/index.js"
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  },
  "files": [
    "dist",
    "src",
    "templates",
    "snippets"
  ],
  "license": "MIT",
  "dependencies": {
    "@lezer/common": "^1.5.0",
    "@lezer/lr": "^1.4.7",
    "@lezer/python": "^1.1.18"
  }
}
