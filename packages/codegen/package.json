{
  "name": "@mlx-node/codegen",
  "version": "0.1.0",
  "description": "Code generators for mlx-node (TypeScript definitions and N-API bindings)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mlx-node/parser": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT"
}
