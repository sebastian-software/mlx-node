{
  "name": "@mlx-node/cli",
  "version": "0.1.0",
  "description": "CLI tools for mlx-node code generation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mlx-generate": "./bin/mlx-generate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "generate": "node dist/generate.js"
  },
  "dependencies": {
    "@mlx-node/parser": "workspace:*",
    "@mlx-node/codegen": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "scripts"
  ],
  "license": "MIT"
}
